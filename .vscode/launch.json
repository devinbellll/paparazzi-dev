{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ANTON_MFC (nps)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/sim_anton.py",
            "args": ["--mfc"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "build: ANTON_MFC nps"
        },
        {
            "name": "ANTON_MFC (nps) — no rebuild",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/sim_anton.py",
            "args": ["--mfc"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "ANTON (nps)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/sim_anton.py",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "build: ANTON nps"
        },
        {
            "name": "ANTON (nps) — no rebuild",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/sim_anton.py",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Remote C: simsitl via QEMU :1234  (Rosetta fallback)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/paparazzi/var/aircrafts/ANTON_MFC/nps/simsitl",
            "miDebuggerServerAddress": "localhost:1234",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb-multiarch",
            "cwd": "${workspaceFolder}/paparazzi",
            "stopAtConnect": true,
            "setupCommands": [
                { "text": "set architecture i386:x86-64", "ignoreFailures": true },
                { "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        }
    ]
}