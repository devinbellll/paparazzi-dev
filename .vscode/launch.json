{
    "version": "0.2.0",
    "configurations": [
        {
            // Debug the NPS sim's firmware C code. First run the task
            // "Sim: Hoops_111_MFC (gdb wait :1234)" (sim.sh Hoops_111_MFC --gdb), which builds
            // incrementally (only if needed) and starts gdbserver inside the build
            // container on :1234. On Mac/Docker Desktop
            // the port is published (-p 1234:1234); from the sbx sandbox publish it
            // with `sbx ports "$SANDBOX_VM_ID" --publish 1234:1234`, then attach.
            //
            // Requires a Linux-arm64-capable gdb on the Mac (e.g. gdb-multiarch via
            // `brew install gdb`/`arm-none-eabi-gdb`). sourceFileMap maps the
            // container's /workspace root to this repo so breakpoints resolve.
            "name": "Attach: NPS sim C (gdbserver :1234)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/paparazzi/var/aircrafts/ANTON_MFC/nps/simsitl",
            "miDebuggerServerAddress": "localhost:1234",
            "MIMode": "gdb",
            "miDebuggerPath": "/opt/homebrew/bin/gdb-multiarch",
            "cwd": "${workspaceFolder}/paparazzi",
            "stopAtConnect": true,
            "sourceFileMap": { "/workspace": "${workspaceFolder}" },
            "setupCommands": [
                { "text": "set architecture aarch64", "ignoreFailures": true },
                { "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        },
        {
            // Debug the Python orchestration (sim_anton.py) itself. Needs ivy-python
            // installed on the Mac (`pip install ivy-python`); the sim subprocesses
            // it launches still require the container, so prefer the C attach above
            // for firmware debugging and use this only to step the launcher logic.
            "name": "Python: sim_anton.py (--mfc)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/sim_anton.py",
            "args": ["--mfc"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
