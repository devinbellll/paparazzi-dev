{
    "version": "2.0.0",
    // All tasks key off the active C/C++ configuration name from the status-bar
    // picker (${command:cpptools.activeConfigName}, e.g. "ANTON_MFC (ap)").
    // pprz.sh accepts that "AIRCRAFT (target)" form directly.
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "${workspaceFolder}/pprz.sh",
            "args": [
                "build",
                "${command:cpptools.activeConfigName}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "${workspaceFolder}/pprz.sh",
            "args": [
                "clean",
                "${command:cpptools.activeConfigName}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Rebuild (clean + build)",
            "type": "shell",
            "command": "${workspaceFolder}/pprz.sh",
            "args": [
                "rebuild",
                "${command:cpptools.activeConfigName}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "IntelliSense: regenerate compile DB",
            "detail": "compile_commands.json for clangd (clean verbose build via compiledb, paths rewritten to host). Run after XML / file-set / define changes.",
            "type": "shell",
            "command": "${workspaceFolder}/pprz.sh",
            "args": [
                "db",
                "${command:cpptools.activeConfigName}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Codegen only (airframe.h / modules.h)",
            "detail": "regenerate generated headers after editing the airframe XML, without compiling",
            "type": "shell",
            "command": "${workspaceFolder}/pprz.sh",
            "args": [
                "codegen",
                "${command:cpptools.activeConfigName}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Bootstrap ground segment",
            "detail": "(re)build the OCaml ground segment + code generators (rarely needed — pulls / messages.xml changes)",
            "type": "shell",
            "command": "${workspaceFolder}/pprz.sh",
            "args": [
                "bootstrap"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Build toolchain image",
            "detail": "build/refresh the paparazzi-build container image",
            "type": "shell",
            "command": "${workspaceFolder}/build_image.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Sim: Hoops_111_MFC (takeoff)",
            "type": "shell",
            "command": "${workspaceFolder}/sim.sh",
            "args": [
                "Hoops_111_MFC"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Sim: Hoops_111_MFC (gdb wait :1234)",
            "type": "shell",
            "command": "${workspaceFolder}/sim.sh",
            "args": [
                "Hoops_111_MFC",
                "--gdb"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ]
}
