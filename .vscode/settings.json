{
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.preview.editor"
  },
  "makefile.makePath": "make",
  "makefile.makefilePath": "${workspaceFolder}/paparazzi/Makefile.ac",
  "makefile.makeDirectory": "${workspaceFolder}/paparazzi",
  "makefile.launchConfigurations": [],
  "makefile.defaultConfiguration": "ANTON_MFC (ap)",
  "makefile.configurations": [
    {
      "name": "ANTON_MFC (ap)",
      "makeArgs": [
        "-f", "Makefile.ac",
        "AIRCRAFT=ANTON_MFC",
        "CONF_XML=${workspaceFolder}/paparazzi/conf/airframes/ENAC/conf_enac.xml",
        "USE_LTO=no",
        "ap.compile"
      ],
      "buildLog": "${workspaceFolder}/paparazzi/var/aircrafts/ANTON_MFC/ap/build.log"
    },
    {
      "name": "ANTON_MFC (nps)",
      "makeArgs": [
        "-f", "Makefile.ac",
        "AIRCRAFT=ANTON_MFC",
        "CONF_XML=${workspaceFolder}/paparazzi/conf/airframes/ENAC/conf_enac.xml",
        "nps.compile"
      ],
      "buildLog": "${workspaceFolder}/paparazzi/var/aircrafts/ANTON_MFC/nps/build.log"
    },
    {
      "name": "ANTON (ap)",
      "makeArgs": [
        "-f", "Makefile.ac",
        "AIRCRAFT=ANTON",
        "CONF_XML=${workspaceFolder}/paparazzi/conf/airframes/ENAC/conf_enac.xml",
        "USE_LTO=no",
        "ap.compile"
      ],
      "buildLog": "${workspaceFolder}/paparazzi/var/aircrafts/ANTON/ap/build.log"
    },
    {
      "name": "ANTON (nps)",
      "makeArgs": [
        "-f", "Makefile.ac",
        "AIRCRAFT=ANTON",
        "CONF_XML=${workspaceFolder}/paparazzi/conf/airframes/ENAC/conf_enac.xml",
        "nps.compile"
      ],
      "buildLog": "${workspaceFolder}/paparazzi/var/aircrafts/ANTON/nps/build.log"
    },
    {
      "name": "ANTON_MFC_THRUST (ap)",
      "makeArgs": [
        "-f", "Makefile.ac",
        "AIRCRAFT=ANTON_MFC_THRUST",
        "CONF_XML=${workspaceFolder}/paparazzi/conf/airframes/ENAC/conf_enac.xml",
        "USE_LTO=no",
        "ap.compile"
      ],
      "buildLog": "${workspaceFolder}/paparazzi/var/aircrafts/ANTON_MFC_THRUST/ap/build.log"
    },
    {
      "name": "ANTON_MFC_THRUST (nps)",
      "makeArgs": [
        "-f", "Makefile.ac",
        "AIRCRAFT=ANTON_MFC_THRUST",
        "CONF_XML=${workspaceFolder}/paparazzi/conf/airframes/ENAC/conf_enac.xml",
        "nps.compile"
      ],
      "buildLog": "${workspaceFolder}/paparazzi/var/aircrafts/ANTON_MFC_THRUST/nps/build.log"
  ]
}