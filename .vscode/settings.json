{
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.preview.editor"
  },

  // ── IntelliSense via clangd (not the MS C/C++ engine) ──────────────────────
  // Builds run in an ephemeral Linux container; clangd reads the host-path
  // compile_commands.json produced by `./pprz.sh db "<config>"`. The MS C/C++
  // IntelliSense engine is disabled to avoid two engines fighting, but the
  // extension stays installed so the config-name picker (status bar) still
  // drives ${command:cpptools.activeConfigName} for the build/db/log tasks.
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}",
    "--background-index",
    "--header-insertion=never",
    // Trust the ARM cross-compiler for system-include discovery (needs a Mac
    // arm-none-eabi-gcc + a DB regenerated with PPRZ_HOST_CC — see .clangd).
    "--query-driver=**/arm-none-eabi-*"
  ],

  // The build/db/log/codegen tasks key off the active C/C++ configuration name
  // ("AIRCRAFT (target)"), so the single picker still drives everything.
  "files.associations": {
    "*.h": "c"
  }
}
