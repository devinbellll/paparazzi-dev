# ── Layer 5: Paparazzi UAV Toolchains ─────────────────────────────────────────
# Headless firmware-build layer on top of the Claude Code devcontainer base.
#
# Build sequence:
#   docker build --platform linux/amd64 -f .devcontainer/Dockerfile -t claude-code-base .devcontainer/
#   docker build --platform linux/amd64 -f Dockerfile.paparazzi -t claude-code-paparazzi .
# ─────────────────────────────────────────────────────────────────────────────

FROM claude-code-base

USER root

# Scoped to RUN only — does not leak into the running container
ARG DEBIAN_FRONTEND=noninteractive

# ── Paparazzi PPA ─────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:paparazzi-uav/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    paparazzi-dev \
    paparazzi-jsbsim \
    && rm -rf /var/lib/apt/lists/*

# ── ARM cross-compiler ────────────────────────────────────────────────────────
# libnewlib-* must be explicit: gcc-arm-none-eabi only recommends it, so
# --no-install-recommends would drop the bare-metal C standard library.
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc-arm-none-eabi \
    libnewlib-arm-none-eabi \
    libnewlib-dev \
    libstdc++-arm-none-eabi-newlib \
    libboost-program-options-dev \
    libboost-filesystem-dev \
    cmake \
    && rm -rf /var/lib/apt/lists/*

# ── Python build dependencies ─────────────────────────────────────────────────
# python-is-python3: Paparazzi build scripts call `python`, not `python3`.
# python3-lxml / python3-empy: XML airframe config parsing and code-gen templates.
# Both are recommends of paparazzi-dev; --no-install-recommends drops them.
# python3-empy on Ubuntu 24.04 is 3.3.4+dfsg1 — the last compatible API version.
# python3-future / python3-zombie-imp: Python 2→3 shims present in pprz-dep.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python-is-python3 \
    python3-lxml \
    python3-empy \
    python3-future \
    python3-zombie-imp \
    python3-pexpect \
    && rm -rf /var/lib/apt/lists/*

# ── Environment ───────────────────────────────────────────────────────────────
ENV PAPARAZZI_HOME=/workspace/paparazzi
ENV PAPARAZZI_SRC=/workspace/paparazzi

USER vscode

WORKDIR /workspace
